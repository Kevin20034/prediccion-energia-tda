# Copia este archivo a .env y rellena los valores reales.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# --- Base de datos: Neon (PostgreSQL serverless) ---------------------------
# Consíguelas en https://console.neon.tech -> tu proyecto -> Connection Details.
# Neon entrega dos hostnames: uno con "-pooler" y uno sin él. Usa ambos.
DATABASE_URL=postgresql+psycopg2://USUARIO:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg2://USUARIO:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Seguridad -------------------------------------------------------------
# Genera una:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Usuario administrador inicial (lo crea scripts/seed.py) ---------------
ADMIN_EMAIL=admin@tda.edu.co
ADMIN_PASSWORD=cambia-esta-password

# --- Fuentes de datos ------------------------------------------------------
XM_API_KEY=
XM_API_URL=https://servapibi.xm.com.co
CLIMA_LATITUD=6.2442
CLIMA_LONGITUD=-75.5812

# --- Aplicación ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Ingesta automática ----------------------------------------------------
# Con esto en true, la API vuelve a consultar XM y el clima cada
# INGESTA_INTERVALO_MINUTOS y guarda lo nuevo. Sin ella, los datos solo se
# actualizan cuando alguien ejecuta los scripts a mano.
#
# Déjala en false en tu equipo de desarrollo. Encendida:
#   - cada arranque con --reload levanta DOS procesos, y ambos descargarían;
#   - los scripts y las pruebas dispararían peticiones reales a XM.
# Enciéndela en un único despliegue, el que deba mantenerse al día.
INGESTA_AUTOMATICA=false

# XM publica una vez por hora en el mejor de los casos: revisar más a menudo
# solo gasta cuota de la API para traer exactamente lo mismo.
INGESTA_INTERVALO_MINUTOS=60
